# Credenciais reais — nunca versionar. api/config.example.php é o template que fica no repo;
# o config.php real com dados reais é criado uma vez direto no servidor (ou localmente pra
# testes) e nunca sobe pro GitHub.
api/config.php

# Ferramentas de uso pontual (gerar hash de senha, recuperar dados de outra origem) — úteis
# de ter no projeto local, mas não devem ficar publicadas no site em produção nem se repetir
# a cada deploy automático. Rode localmente quando precisar, suba na mão só quando for usar.
api/generate-password-hash.php
export-legacy-data.html
import-data.html

# Arquivos de SO
.DS_Store
Thumbs.db

# Sons customizados enviados pelo admin (dado de usuário, não código) — a pasta em si fica
# versionada (.gitkeep) pra existir num clone novo, só o conteúdo enviado é ignorado.
uploads/sounds/*
!uploads/sounds/.gitkeep
!uploads/sounds/.htaccess

# Memória/plans locais do Claude Code (específico desta máquina, não faz sentido versionar)
.claude/
